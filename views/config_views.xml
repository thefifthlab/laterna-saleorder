<odoo>
    <record id="res_config_settings_view_form_inherit_my_integration" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.laterna</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Laterna Integration" name="laterna">
                    <block title="API Courier Integration Settings" name="api_settings_container">
                        <setting id="api_credentials_setting" help="Configure external API credentials">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" for="my_api_base_url"/>
                                    <field name="my_api_base_url" placeholder="https://api.example.com"/>
                                </div>
                                <div class="row mt16">
                                    <label class="col-lg-3 o_light_label" for="my_api_token"/>
                                    <field name="my_api_token" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>